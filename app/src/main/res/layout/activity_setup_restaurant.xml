<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Up Your Restaurant"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Let's get your restaurant listed on our platform"
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginBottom="28dp" />

        <!-- Restaurant Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restaurant Name *"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRestaurantName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., Burger Palace"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:elevation="1dp"
            android:textSize="14sp"
            android:inputType="textPersonName"
            android:layout_marginBottom="20dp" />

        <!-- Restaurant City -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restaurant City *"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., Beijing"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:elevation="1dp"
            android:textSize="14sp"
            android:inputType="textPersonName"
            android:layout_marginBottom="20dp" />

        <!-- Restaurant District -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restaurant District*"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etDistrict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., Chaoyang"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:elevation="1dp"
            android:textSize="14sp"
            android:inputType="textPersonName"
            android:layout_marginBottom="20dp" />

        <!-- Restaurant Image -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restaurant District"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_marginBottom="12dp" />

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Restaurant image preview"
            android:layout_marginBottom="12dp" />

        <!-- Pick Image Button -->
        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Image"
            android:backgroundTint="#8B4513"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Complete Setup Button -->
        <Button
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete Setup"
            android:backgroundTint="#8B4513"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:padding="14dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Alert Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡Alert: You can not update these details later."
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>